# -----------------------------------------------------------------------------
# Example file. Copy it to root.hcl in this folder and fill in your values:
#   cp root.hcl.example root.hcl
#
#   # REQUIRED   you must change it
#   # CHANGE-ME  works as-is, but should match your naming / organisation
#   # SENSITIVE  identifies your tenant or people - keep out of public repos
#
# root.hcl is git-ignored. Never commit it.
# -----------------------------------------------------------------------------

terragrunt_version_constraint = ">= 1.1.1" # required for autoinclude blocks

locals {

  # REQUIRED, SENSITIVE: subscription the hub deploys into, and its Entra ID
  # tenant. In a landing zone this is usually the Connectivity subscription;
  # it can be the same subscription as prod. Find them with:
  #   az account show --query "{subscription_id:id, tenant_id:tenantId}" -o table
  subscription_id = "00000000-0000-0000-0000-000000000000"
  tenant_id       = "00000000-0000-0000-0000-000000000000"

  # CHANGE-ME: used to build resource names, e.g. rg-<location_code>-<environment>-<project>-...
  location      = "eastus" # Azure region
  location_code = "eus"    # short code for the region
  environment   = "hub"
  project       = "alphaai"
  instance      = "001"

  # CHANGE-ME: tags applied to every resource.
  tags = {
    owner       = "DevOps"
    department  = "Data"
    terraform   = "True"
    repository  = "<your-repo-name>"
    environment = "hub"
    project     = "alphaai"
    costcenter  = "000000"
  }

}

remote_state {
  backend = "azurerm"
  config = {
    # REQUIRED: the state backend created by 01bootstrap. Use the same values
    # as subscription_id, resource_group_name, storage_account_name and
    # container_names[0] in 01bootstrap/<env>/env.hcl.
    subscription_id      = "00000000-0000-0000-0000-000000000000" # SENSITIVE
    resource_group_name  = "rg-<region>-<env>-<project>-tfstate-001"
    storage_account_name = "sttfstateexample001"
    container_name       = "tfstate"
    # See 02environments/prod/root.hcl for why get_parent_terragrunt_dir()
    # is used here instead of find_in_parent_folders()/path_relative_to_include().
    # basename(get_parent_terragrunt_dir()) resolves to "hub" here, so keys
    # never collide with prod's "prod/<unit>" keys in the same container.
    key              = "${basename(get_parent_terragrunt_dir())}/${basename(get_terragrunt_dir())}"
    use_azuread_auth = true
    use_oidc         = true
  }
}

generate "versions" {
  path              = "versions.tf"
  if_exists         = "overwrite"
  contents          = file(find_in_parent_folders("versions.tf"))
  disable_signature = true
}

generate "globals" {
  path      = "globals.tf"
  if_exists = "overwrite"

  contents = <<EOF
variable "subscription_id" {
  type = string
}

variable "tenant_id" {
  type = string
}

variable "location" {
  type = string
}

variable "environment" {
  type = string
}

variable "location_code" {
  type = string
}

variable "tags" {
  type = map(string)
}

EOF
}

generate "providers" {
  path      = "providers.tf"
  if_exists = "overwrite"

  contents = <<EOF

provider "azurerm" {
  subscription_id     = var.subscription_id
  tenant_id           = var.tenant_id
  storage_use_azuread = true
  features {
    resource_group {
      prevent_deletion_if_contains_resources = true
    }
  }
}

provider "azuread" {
  tenant_id = var.tenant_id
}

# Reads CLOUDFLARE_API_TOKEN from the environment — no credentials in code.
provider "cloudflare" {}

terraform {
  backend "azurerm" {}
}

EOF
}
