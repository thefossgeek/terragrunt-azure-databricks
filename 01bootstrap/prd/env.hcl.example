# -----------------------------------------------------------------------------
# Bootstrap environment config (example)
#
# How to use:
#   1. Copy this file:   cp env.hcl.example env.hcl
#   2. Replace every value marked  # REQUIRED  with your own.
#   3. Review values marked         # CHANGE-ME  (safe defaults, but they should
#      reflect your naming convention / organisation).
#
# env.hcl is git-ignored. Never commit it: it holds your subscription ID and
# user principal names (email addresses).
#
# Values marked # SENSITIVE identify your tenant or people in it. They are not
# secrets that grant access on their own, but keep them out of public repos.
# -----------------------------------------------------------------------------
locals {
  # REQUIRED, SENSITIVE: target Azure subscription ID (GUID).
  # Find it with:  az account show --query id -o tsv
  subscription_id = "00000000-0000-0000-0000-000000000000"

  # CHANGE-ME: resource group that holds the Terraform state storage account.
  # Created by this module (create_resource_group defaults to true).
  resource_group_name = "rg-<region>-<env>-<project>-tfstate-001"

  # CHANGE-ME: Azure region, e.g. "eastus", "westeurope", "uksouth".
  # List regions with:  az account list-locations --query "[].name" -o tsv
  location = "eastus"

  # REQUIRED: storage account for Terraform state. Must be GLOBALLY unique
  # across Azure, 3-24 characters, lowercase letters and digits only.
  # Check availability with:
  #   az storage account check-name --name <name> --query nameAvailable
  storage_account_name = "sttfstateexample001"

  # CHANGE-ME: LRS, ZRS, GRS or GZRS. ZRS is not available in every region.
  replication_type = "ZRS"

  # CHANGE-ME: blob containers to create. The first entry is used as the
  # remote state container in terragrunt.hcl.
  container_names = ["tfstate"]

  # CHANGE-ME: Entra ID security group granted Storage Blob Data Contributor
  # on the state storage account. Created by this module unless
  # create_group = false, in which case an existing group with this display
  # name is looked up instead.
  group_display_name = "sg-<env>-devops-engineers"
  group_description  = "<ENV> DevOps engineers access group. Do not delete - required for RBAC and platform operations."

  # REQUIRED, SENSITIVE: user principal names (UPNs) of the group owners and
  # members. Use UPNs from YOUR Entra ID tenant.
  #   - Member user:  "jane.doe@contoso.com"
  #   - Guest user:   "jane.doe_example.com#EXT#@contoso.onmicrosoft.com"
  # Find a UPN with:  az ad user show --id <email> --query userPrincipalName -o tsv
  # Include yourself in group_member_upns, otherwise you will lose data-plane
  # access to the state container after the first apply.
  group_owner_upns  = ["owner@contoso.com"]
  group_member_upns = ["owner@contoso.com", "engineer@contoso.com"]

  # CHANGE-ME: tags applied to every resource. Adjust keys/values to your
  # organisation's tagging policy.
  tags = {
    owner       = "DevOps"
    department  = "Data"
    terraform   = "True"
    repository  = "<your-repo-name>"
    environment = "prd"
    project     = "<project>"
    costcenter  = "000000"
  }

  # Day 1: leave as-is. Day 2: set enable_private_endpoint = true and fill in
  # private_endpoint_subnet_id / private_dns_zone_id below, then apply again.
  # Example IDs:
  #   /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>
  #   /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/privateDnsZones/privatelink.blob.core.windows.net
  enable_private_endpoint    = false
  private_endpoint_subnet_id = null
  private_dns_zone_id        = null

  # Day 1: leave as-is. Day 2: set enable_diagnostics = true and fill in
  # log_analytics_workspace_id below, then apply again.
  # Example ID:
  #   /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<workspace>
  enable_diagnostics         = false
  log_analytics_workspace_id = null
}
